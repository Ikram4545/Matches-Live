# Matches Live Backend Configuration (DO NOT COMMIT .env WITH REAL SECRETS)

PORT=5000
NODE_ENV=production

# Required for POST /api/admin/* endpoints (generate a strong 32+ char random token)
ADMIN_API_TOKEN=replace-with-strong-random-secret-token

# Required in production: comma-separated allowlist of approved HTTPS streaming CDN hosts
# Example: ALLOWED_STREAM_HOSTS=cdn.authorized-provider.com,rbmn-live.akamaized.net,cdn.pishow.tv
ALLOWED_STREAM_HOSTS=rbmn-live.akamaized.net,cdn.pishow.tv

# Set to true ONLY in local/staging environments to allow demo/staging items in responses
ALLOW_DEMO_FEEDS=false

# Background HLS playlist health check interval in milliseconds (default: 60000; 0 disables timer)
HEALTH_CHECK_INTERVAL_MS=60000

# Optional real live scores API integration (e.g. CricketData.org / Sportmonks / RapidAPI)
# CRICKET_API_URL=https://api.cricapi.com/v1/currentMatches
# CRICKET_API_KEY=your-live-scores-api-key
SCORE_CACHE_TTL_MS=15000

# Ad SDK Configuration (Unity Ads — approved for direct-download Android APKs)
# Leave UNITY_TEST_MODE=true until live ad approval is confirmed on release build
UNITY_GAME_ID=
UNITY_BANNER_PLACEMENT=Banner_Android
UNITY_INTERSTITIAL_PLACEMENT=Interstitial_Android
UNITY_TEST_MODE=true
